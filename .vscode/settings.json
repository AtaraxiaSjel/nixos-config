{
    "files.eol": "\n",
    "[nix]": {
        "editor.tabSize": 2
    },
    "nix.enableLanguageServer": true,
    "nix.serverPath": "nixd",
    "nix.serverSettings": {
        "nixd": {
            "formatting": {
                "command": [
                    "nixfmt"
                ],
            },
            "nixpkgs": {
                "expr": "import (builtins.getFlake \"${workspaceFolder}\").currentSystem.allModuleArgs.liteConfigNixpkgs { }"
            },
            "options": {
                "nixos": {
                    "expr": "(builtins.getFlake \"${workspaceFolder}\").nixosConfigurations.andromedae.options",
                },
                "home-manager": {
                    "expr": "(builtins.getFlake \"${workspaceFolder}\").nixosConfigurations.andromedae.options.home-manager.users.type.getSubOptions []",
                },
            },
        },
    },
    "cSpell.enabled": false
}