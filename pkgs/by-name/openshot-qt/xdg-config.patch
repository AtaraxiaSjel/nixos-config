diff --git a/src/tests/test_user_paths.py b/src/tests/test_user_paths.py
new file mode 100644
index 0000000..7b6823f
--- /dev/null
+++ b/src/tests/test_user_paths.py
@@ -0,0 +1,62 @@
+"""Tests for XDG-aware user directory resolution."""
+
+import os
+import unittest
+from unittest.mock import patch
+
+from classes import user_paths
+
+
+class UserPathTests(unittest.TestCase):
+    def resolve(self, platform="linux", **environment):
+        env = {"HOME": "/home/test"}
+        env.update(environment)
+        with patch.dict(os.environ, env, clear=True):
+            return user_paths.default_user_path(platform)
+
+    def test_linux_uses_xdg_config_home(self):
+        self.assertEqual(
+            self.resolve(XDG_CONFIG_HOME="/srv/config"),
+            "/srv/config/openshot_qt")
+
+    def test_linux_accepts_xdg_config_dir_alias(self):
+        self.assertEqual(
+            self.resolve(XDG_CONFIG_DIR="/srv/config"),
+            "/srv/config/openshot_qt")
+
+    def test_standard_xdg_variable_has_precedence(self):
+        self.assertEqual(
+            self.resolve(XDG_CONFIG_HOME="/srv/standard",
+                         XDG_CONFIG_DIR="/srv/alias"),
+            "/srv/standard/openshot_qt")
+
+    def test_relative_xdg_path_is_ignored(self):
+        self.assertEqual(
+            self.resolve(XDG_CONFIG_HOME="relative/config"),
+            "/home/test/.config/openshot_qt")
+
+    def test_linux_falls_back_to_home_config(self):
+        self.assertEqual(
+            self.resolve(),
+            "/home/test/.config/openshot_qt")
+
+    def test_explicit_environment_is_honoured(self):
+        self.assertEqual(
+            user_paths.default_user_path("linux", {"HOME": "/srv/home"}),
+            "/srv/home/.config/openshot_qt")
+
+    def test_tilde_paths_use_environment_home(self):
+        self.assertEqual(
+            self.resolve(XDG_CONFIG_HOME="~/.config-alt"),
+            "/home/test/.config-alt/openshot_qt")
+
+    def test_other_platforms_keep_legacy_directory(self):
+        for platform in ("darwin", "win32"):
+            with self.subTest(platform=platform):
+                self.assertEqual(
+                    self.resolve(platform, XDG_CONFIG_HOME="/srv/config"),
+                    "/home/test/.openshot_qt")
+
+
+if __name__ == "__main__":
+    unittest.main()
