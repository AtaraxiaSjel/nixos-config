diff --git a/src/classes/user_paths.py b/src/classes/user_paths.py
new file mode 100644
index 0000000..b98a833
--- /dev/null
+++ b/src/classes/user_paths.py
@@ -0,0 +1,89 @@
+"""
+ @file
+ @brief Resolve OpenShot's per-user configuration directory.
+
+ @section LICENSE
+
+ Copyright (c) 2008-2026 OpenShot Studios, LLC
+ (http://www.openshotstudios.com). This file is part of
+ OpenShot Video Editor (http://www.openshot.org), an open-source project
+ dedicated to delivering high quality video editing and animation solutions
+ to the world.
+
+ OpenShot Video Editor is free software: you can redistribute it and/or modify
+ it under the terms of the GNU General Public License as published by
+ the Free Software Foundation, either version 3 of the License, or
+ (at your option) any later version.
+
+ OpenShot Video Editor is distributed in the hope that it will be useful,
+ but WITHOUT ANY WARRANTY; without even the implied warranty of
+ MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ GNU General Public License for more details.
+
+ You should have received a copy of the GNU General Public License
+ along with OpenShot Library.  If not, see <http://www.gnu.org/licenses/>.
+ """
+
+import os
+import sys
+
+# Directory name used below the platform's configuration root.
+APP_DIR_NAME = "openshot_qt"
+
+# Historical directory used on platforms without an XDG configuration root.
+LEGACY_DIR_NAME = ".openshot_qt"
+
+# XDG_CONFIG_HOME is the standard variable. XDG_CONFIG_DIR is accepted as an
+# alias for environments and wrappers that spell it that way.
+XDG_CONFIG_VARIABLES = ("XDG_CONFIG_HOME", "XDG_CONFIG_DIR")
+
+
+def _environ(environ=None):
+    return os.environ if environ is None else environ
+
+
+def _home(environ):
+    """Return the user's home directory, honouring the supplied environment."""
+    home = environ.get("HOME")
+    return os.path.expanduser(home) if home else os.path.expanduser("~")
+
+
+def _expand_user(path, environ):
+    """Expand ``~`` using the supplied environment's HOME."""
+    if path == "~":
+        return _home(environ)
+    if path.startswith("~/"):
+        return os.path.join(_home(environ), path[2:])
+    return path
+
+
+def config_home(environ=None):
+    """Return the user's XDG configuration root.
+
+    Relative paths are ignored as required by the XDG Base Directory
+    Specification. When no usable variable is set, ``$HOME/.config`` is used.
+    """
+    environ = _environ(environ)
+    for name in XDG_CONFIG_VARIABLES:
+        value = environ.get(name, "")
+        if not value:
+            continue
+        value = _expand_user(value, environ)
+        if os.path.isabs(value):
+            return os.path.normpath(value)
+    return os.path.join(_home(environ), ".config")
+
+
+def default_user_path(platform=None, environ=None):
+    """Return the directory where OpenShot stores settings and user data.
+
+    Linux follows the XDG Base Directory Specification, using
+    ``$XDG_CONFIG_HOME/openshot_qt`` (or ``$HOME/.config/openshot_qt`` when
+    the variable is unset). Other platforms keep their historical
+    ``$HOME/.openshot_qt`` location.
+    """
+    environ = _environ(environ)
+    platform = sys.platform if platform is None else platform
+    if platform.startswith("linux"):
+        return os.path.join(config_home(environ), APP_DIR_NAME)
+    return os.path.join(_home(environ), LEGACY_DIR_NAME)
