@@ -0,0 +1,20 @@
+#! @runtimeShell@
+export PATH=@binPath@:$PATH
+
+# This unit is started by a timer shortly after boot, so it must not be part
+# of the container's boot transaction. It waits for the long-running parts of
+# the bring-up (database seed and kasm_guac network attach) before starting
+# the proxy and its Requires chain.
+
+# Wait for the database seed performed by the kasm_db_init container to
+# finish before starting the API-dependent services.
+while [ ! -e @datastorePath@/.done_initing_data ]; do
+    sleep 10;
+done
